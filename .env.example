# Frontend public configuration (fill after Auth0 integration)
# Leave blank for local fixtures. Set only after testing the deployed Worker.
VITE_API_BASE_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Worker secrets: configure securely; DO NOT commit actual values.
# AUTH0_ISSUER_BASE_URL=https://YOUR-TENANT.auth0.com/
# AUTH0_AUDIENCE=https://api.bioflow.example/
# BIOFLOW_OWNER_SUB=auth0|....
# APP_ORIGIN=http://localhost:5173
# Bind a private R2 bucket as REPORTS_BUCKET in wrangler config.

# Atlas synthetic demonstration ONLY. Put real values in ignored .env.local.
MONGODB_URI=mongodb+srv://DEMO_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/
MONGODB_DB=bioflow_demo
# Never expose MONGODB_URI through a frontend VITE_ variable.

